---
interface Props {
  articles: {
    id: string;
    title: string;
    excerpt: string;
    category: string;
    tags: string[];
    author: string;
  }[];
}

const { articles } = Astro.props;
---

<div class="search-modal" id="search-modal">
  <div class="search-overlay" id="search-overlay"></div>
  <div class="search-container">
    <div class="search-header">
      <span class="search-icon">🔍</span>
      <input 
        type="text" 
        class="search-input" 
        id="search-input" 
        placeholder="搜索文章标题、内容、标签..."
        autocomplete="off"
      />
      <button class="search-close" id="search-close" aria-label="关闭">
        <span>✕</span>
      </button>
    </div>
    <div class="search-results" id="search-results"></div>
    <div class="search-footer">
      <span class="search-hint">
        <kbd>↑</kbd> <kbd>↓</kbd> 选择
        <kbd>Enter</kbd> 打开
        <kbd>Esc</kbd> 关闭
      </span>
    </div>
  </div>
</div>

<script define:vars={{ articles }}>
  const modal = document.getElementById('search-modal');
  const overlay = document.getElementById('search-overlay');
  const input = document.getElementById('search-input');
  const closeBtn = document.getElementById('search-close');
  const resultsContainer = document.getElementById('search-results');
  
  let selectedIndex = -1;
  let filteredArticles = [];

  function openSearch() {
    modal.classList.add('open');
    input.value = '';
    input.focus();
    filteredArticles = [];
    renderResults([]);
    document.body.style.overflow = 'hidden';
  }

  function closeSearch() {
    modal.classList.remove('open');
    document.body.style.overflow = '';
    selectedIndex = -1;
  }

  function normalizeText(text) {
    return text.toLowerCase().replace(/\s+/g, '');
  }

  function searchArticles(query) {
    if (!query.trim()) return [];
    
    const normalizedQuery = normalizeText(query);
    
    return articles.filter(article => {
      const titleMatch = normalizeText(article.title).includes(normalizedQuery);
      const excerptMatch = normalizeText(article.excerpt).includes(normalizedQuery);
      const categoryMatch = normalizeText(article.category).includes(normalizedQuery);
      const authorMatch = normalizeText(article.author).includes(normalizedQuery);
      const tagsMatch = article.tags.some(tag => normalizeText(tag).includes(normalizedQuery));
      
      return titleMatch || excerptMatch || categoryMatch || authorMatch || tagsMatch;
    }).slice(0, 8);
  }

  function renderResults(results) {
    filteredArticles = results;
    selectedIndex = -1;
    
    if (results.length === 0) {
      resultsContainer.innerHTML = input.value.trim() 
        ? '<div class="search-no-results">没有找到相关文章</div>'
        : '<div class="search-no-results">输入关键词开始搜索</div>';
      return;
    }

    resultsContainer.innerHTML = results.map((article, index) => `
      <a href="/articles/${article.id}" class="search-result-item" data-index="${index}">
        <div class="search-result-title">${highlightMatch(article.title, input.value)}</div>
        <div class="search-result-meta">
          <span class="search-result-category">${article.category}</span>
          <span class="search-result-author">${article.author}</span>
        </div>
        <div class="search-result-excerpt">${article.excerpt}</div>
      </a>
    `).join('');

    // Add click handlers
    resultsContainer.querySelectorAll('.search-result-item').forEach((item, index) => {
      item.addEventListener('click', () => {
        closeSearch();
      });
      item.addEventListener('mouseenter', () => {
        selectedIndex = index;
        updateSelection();
      });
    });
  }

  function highlightMatch(text, query) {
    if (!query.trim()) return text;
    const regex = new RegExp(`(${query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi');
    return text.replace(regex, '<mark>$1</mark>');
  }

  function updateSelection() {
    const items = resultsContainer.querySelectorAll('.search-result-item');
    items.forEach((item, index) => {
      item.classList.toggle('selected', index === selectedIndex);
    });
  }

  // Event listeners
  input.addEventListener('input', (e) => {
    const results = searchArticles(e.target.value);
    renderResults(results);
  });

  input.addEventListener('keydown', (e) => {
    const items = resultsContainer.querySelectorAll('.search-result-item');
    
    switch(e.key) {
      case 'ArrowDown':
        e.preventDefault();
        selectedIndex = Math.min(selectedIndex + 1, items.length - 1);
        updateSelection();
        break;
      case 'ArrowUp':
        e.preventDefault();
        selectedIndex = Math.max(selectedIndex - 1, -1);
        updateSelection();
        break;
      case 'Enter':
        e.preventDefault();
        if (selectedIndex >= 0 && filteredArticles[selectedIndex]) {
          window.location.href = `/articles/${filteredArticles[selectedIndex].id}`;
          closeSearch();
        }
        break;
      case 'Escape':
        e.preventDefault();
        closeSearch();
        break;
    }
  });

  closeBtn.addEventListener('click', closeSearch);
  overlay.addEventListener('click', closeSearch);

  // Keyboard shortcut
  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      openSearch();
    }
  });

  // Expose globally
  window.openSearch = openSearch;
</script>

<style>
  .search-modal {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1000;
    display: none;
    align-items: flex-start;
    justify-content: center;
    padding-top: 120px;
  }

  .search-modal.open {
    display: flex;
  }

  .search-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(4px);
  }

  .search-container {
    position: relative;
    width: 90%;
    max-width: 640px;
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-hover);
    overflow: hidden;
  }

  .search-header {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 20px;
    border-bottom: 1px solid var(--border);
  }

  .search-icon {
    font-size: 20px;
    color: var(--text-muted);
  }

  .search-input {
    flex: 1;
    border: none;
    background: none;
    font-family: var(--font-stack);
    font-size: 16px;
    color: var(--text-primary);
    outline: none;
  }

  .search-input::placeholder {
    color: var(--text-muted);
  }

  .search-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border: none;
    background: none;
    cursor: pointer;
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    transition: all 0.2s;
  }

  .search-close:hover {
    background-color: var(--accent-light);
    color: var(--text-primary);
  }

  .search-results {
    max-height: 400px;
    overflow-y: auto;
  }

  .search-no-results {
    padding: 40px 20px;
    text-align: center;
    color: var(--text-muted);
    font-size: 14px;
  }

  .search-result-item {
    display: block;
    padding: 16px 20px;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
    transition: all 0.15s;
  }

  .search-result-item:last-child {
    border-bottom: none;
  }

  .search-result-item:hover,
  .search-result-item.selected {
    background-color: var(--accent-light);
  }

  .search-result-title {
    font-size: 15px;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 4px;
  }

  .search-result-title mark {
    background-color: var(--accent);
    color: white;
    padding: 0 2px;
    border-radius: 2px;
  }

  .search-result-meta {
    display: flex;
    gap: 12px;
    margin-bottom: 6px;
    font-size: 12px;
  }

  .search-result-category {
    color: var(--accent);
    font-weight: 500;
  }

  .search-result-author {
    color: var(--text-muted);
  }

  .search-result-excerpt {
    font-size: 13px;
    color: var(--text-secondary);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .search-footer {
    padding: 12px 20px;
    border-top: 1px solid var(--border);
    background-color: var(--bg);
  }

  .search-hint {
    font-size: 12px;
    color: var(--text-muted);
  }

  .search-hint kbd {
    display: inline-block;
    padding: 2px 6px;
    font-family: var(--font-stack);
    font-size: 11px;
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: 4px;
    margin: 0 2px;
  }

  @media (max-width: 720px) {
    .search-modal {
      padding-top: 80px;
    }

    .search-container {
      width: 95%;
    }

    .search-hint {
      display: none;
    }
  }
</style>
