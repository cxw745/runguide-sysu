---
import PageLayout from '../../layouts/PageLayout.astro';
import { getCollection } from 'astro:content';

const allArticles = await getCollection('articles');
const sortedArticles = allArticles.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const categories = ['全部', '转专业', '保研', '考研', '出国留学', '就业', '其他'];

const majorSet = new Set<string>();
allArticles.forEach(a => {
  if (a.data.major) majorSet.add(a.data.major);
});
const majors = Array.from(majorSet).sort();

const articlesByYear = new Map<string, typeof sortedArticles>();
sortedArticles.forEach(article => {
  const year = article.data.date.substring(0, 4);
  if (!articlesByYear.has(year)) articlesByYear.set(year, []);
  articlesByYear.get(year)!.push(article);
});
const years = Array.from(articlesByYear.keys()).sort((a, b) => b.localeCompare(a));

const articlesByMajor = new Map<string, typeof sortedArticles>();
sortedArticles.forEach(article => {
  const m = article.data.major || '未分类';
  if (!articlesByMajor.has(m)) articlesByMajor.set(m, []);
  articlesByMajor.get(m)!.push(article);
});
const majorKeys = Array.from(articlesByMajor.keys()).sort();
---

<PageLayout title="文章">
  <main class="articles-page">
    <div class="container">
      <div class="articles-page-header">
        <h1 class="articles-page-title">全部文章</h1>
        <p class="articles-page-desc">学长学姐的真实经验分享，总有一篇能帮到你</p>
      </div>
      <div class="articles-filters" id="articles-filters">
        {categories.map(cat => (
          <button
            class:list={['filter-chip', { active: cat === '全部' }]}
            data-category={cat === '全部' ? '' : cat}
          >
            {cat}
          </button>
        ))}
      </div>
      <div class="articles-layout">
        <aside class="articles-sidebar">
          <div class="sidebar-section">
            <h3 class="sidebar-title">📅 按日期索引</h3>
            <ul class="sidebar-list">
              {years.map(year => (
                <li class="sidebar-year">
                  <button class="sidebar-year-btn" data-year={year}>{year}年 ({articlesByYear.get(year)!.length})</button>
                  <ul class="sidebar-sublist">
                    {articlesByYear.get(year)!.map(article => (
                      <li>
                        <a href={`/articles/${article.id}`} class="sidebar-link" data-category={article.data.category}>
                          <span class="sidebar-link-date">{article.data.date.substring(5)}</span>
                          <span class="sidebar-link-title">{article.data.title}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </li>
              ))}
            </ul>
          </div>
          {majorKeys.length > 0 && (
            <div class="sidebar-section">
              <h3 class="sidebar-title">🎓 按专业分类</h3>
              <ul class="sidebar-list">
                {majorKeys.map(major => (
                  <li class="sidebar-year">
                    <button class="sidebar-year-btn" data-major={major}>{major} ({articlesByMajor.get(major)!.length})</button>
                    <ul class="sidebar-sublist">
                      {articlesByMajor.get(major)!.map(article => (
                        <li>
                          <a href={`/articles/${article.id}`} class="sidebar-link" data-category={article.data.category}>
                            <span class="sidebar-link-tag">{article.data.category}</span>
                            <span class="sidebar-link-title">{article.data.title}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </aside>
        <div class="articles-main">
          <div class="article-list" id="article-list">
            {sortedArticles.map(article => (
              <a href={`/articles/${article.id}`} class="article-list-item" data-category={article.data.category}>
                <div class="article-list-body">
                  <h3 class="article-list-title">{article.data.title}</h3>
                  <p class="article-list-excerpt">{article.data.excerpt}</p>
                </div>
                <div class="article-list-meta">
                  <span class="tag article-list-tag">{article.data.category}</span>
                  {article.data.major && <span class="article-list-major">🎓 {article.data.major}</span>}
                  <span class="article-list-author">✍️ {article.data.author}</span>
                  <span class="article-list-date">{article.data.date}</span>
                </div>
              </a>
            ))}
          </div>
          <div class="articles-empty" id="articles-empty" style="display:none;">
            <p>该分类暂无文章</p>
          </div>
        </div>
      </div>
    </div>
  </main>
</PageLayout>

<script>
  const params = new URLSearchParams(window.location.search);
  const categoryParam = params.get('category');

  const chips = document.querySelectorAll('.filter-chip');
  const items = document.querySelectorAll('.article-list-item');
  const sidebarLinks = document.querySelectorAll('.sidebar-link');
  const empty = document.getElementById('articles-empty');

  function filterArticles(category: string) {
    chips.forEach(chip => {
      const chipCat = chip.getAttribute('data-category') || '';
      chip.classList.toggle('active', chipCat === category);
    });

    let visibleCount = 0;
    items.forEach(item => {
      const itemCat = item.getAttribute('data-category') || '';
      const show = !category || itemCat === category;
      (item as HTMLElement).style.display = show ? '' : 'none';
      if (show) visibleCount++;
    });

    sidebarLinks.forEach(link => {
      const linkCat = link.getAttribute('data-category') || '';
      const show = !category || linkCat === category;
      (link as HTMLElement).style.display = show ? '' : 'none';
    });

    empty!.style.display = visibleCount === 0 ? 'block' : 'none';
  }

  if (categoryParam) {
    filterArticles(categoryParam);
  }

  chips.forEach(chip => {
    chip.addEventListener('click', () => {
      const category = chip.getAttribute('data-category') || '';
      filterArticles(category);
      const url = new URL(window.location.href);
      if (category) {
        url.searchParams.set('category', category);
      } else {
        url.searchParams.delete('category');
      }
      history.replaceState(null, '', url.toString());
    });
  });

  document.querySelectorAll('.sidebar-year-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const li = btn.parentElement;
      li!.classList.toggle('open');
    });
  });
</script>

<style>
  .articles-page {
    padding: 48px 0 64px;
    min-height: 60vh;
  }

  .articles-page-header {
    margin-bottom: 32px;
  }

  .articles-page-title {
    font-size: 32px;
    font-weight: 700;
    line-height: 1.3;
    color: var(--text-primary);
    margin-bottom: 8px;
  }

  .articles-page-desc {
    font-size: 16px;
    color: var(--text-secondary);
  }

  .articles-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 28px;
  }

  .filter-chip {
    padding: 6px 16px;
    font-family: var(--font-stack);
    font-size: 13px;
    font-weight: 500;
    color: var(--text-secondary);
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition: all 0.2s;
  }

  .filter-chip:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .filter-chip.active {
    background-color: var(--accent);
    color: #fff;
    border-color: var(--accent);
  }

  .articles-layout {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 32px;
    align-items: start;
  }

  .articles-sidebar {
    position: sticky;
    top: calc(var(--header-height) + 24px);
    max-height: calc(100vh - var(--header-height) - 48px);
    overflow-y: auto;
    padding: 20px;
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
  }

  .sidebar-section {
    margin-bottom: 24px;
  }

  .sidebar-section:last-child {
    margin-bottom: 0;
  }

  .sidebar-title {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border);
  }

  .sidebar-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .sidebar-year {
    margin-bottom: 4px;
  }

  .sidebar-year-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 8px 10px;
    font-family: var(--font-stack);
    font-size: 13px;
    font-weight: 600;
    color: var(--text-primary);
    background: none;
    border: none;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: background-color 0.15s;
  }

  .sidebar-year-btn:hover {
    background-color: var(--accent-light);
  }

  .sidebar-year-btn::after {
    content: '▸';
    font-size: 10px;
    color: var(--text-muted);
    transition: transform 0.2s;
  }

  .sidebar-year.open .sidebar-year-btn::after {
    transform: rotate(90deg);
  }

  .sidebar-sublist {
    display: none;
    list-style: none;
    padding: 0;
    margin: 0 0 4px;
  }

  .sidebar-year.open .sidebar-sublist {
    display: block;
  }

  .sidebar-link {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 10px 6px 20px;
    font-size: 13px;
    color: var(--text-secondary);
    border-radius: var(--radius-sm);
    transition: all 0.15s;
    text-decoration: none;
  }

  .sidebar-link:hover {
    background-color: var(--accent-light);
    color: var(--accent);
    opacity: 1;
  }

  .sidebar-link-date,
  .sidebar-link-tag {
    font-size: 11px;
    color: var(--text-muted);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .sidebar-link-tag {
    padding: 1px 6px;
    background-color: var(--accent-light);
    color: var(--accent);
    border-radius: var(--radius-pill);
  }

  .sidebar-link-title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .articles-main {
    min-width: 0;
  }

  .article-list {
    display: flex;
    flex-direction: column;
  }

  .article-list-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 20px 24px;
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    transition: all 0.2s ease;
    text-decoration: none;
    margin-bottom: 8px;
  }

  .article-list-item:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow-hover);
    opacity: 1;
    transform: translateX(4px);
  }

  .article-list-body {
    flex: 1;
    min-width: 0;
  }

  .article-list-title {
    font-size: 17px;
    font-weight: 600;
    line-height: 1.35;
    color: var(--text-primary);
    margin-bottom: 6px;
  }

  .article-list-excerpt {
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-secondary);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .article-list-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }

  .article-list-tag {
    white-space: nowrap;
  }

  .article-list-major,
  .article-list-author,
  .article-list-date {
    font-size: 12px;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .articles-empty {
    text-align: center;
    padding: 64px 0;
    color: var(--text-muted);
    font-size: 15px;
  }

  @media (max-width: 960px) {
    .articles-layout {
      grid-template-columns: 1fr;
    }

    .articles-sidebar {
      position: static;
      max-height: none;
    }
  }

  @media (max-width: 720px) {
    .article-list-item {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }

    .article-list-meta {
      flex-wrap: wrap;
    }
  }
</style>
